# Database (docker compose up -d)
DATABASE_URL="postgresql://darmakkah:darmakkah@localhost:5434/darmakkah"

# Clerk — from https://dashboard.clerk.com (API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Z.AI GLM (quiz question generation) - server-only; omit the key to use the deterministic fake provider
# For a Z.AI coding-plan key, set GLM_BASE_URL="https://api.z.ai/api/coding/paas/v4"
GLM_API_KEY=""
GLM_MODEL="glm-5.3-flash"
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
GLM_TIMEOUT_MS="30000"

# Per-Teacher AI generation guardrails (server-side)
AI_GENERATIONS_PER_HOUR="30"
AI_MAX_CONCURRENT_GENERATIONS="2"
AI_MAX_TOTAL_SOURCE_CHARS="120000"
