# Database (docker compose up -d)
DATABASE_URL="postgresql://darmakkah:darmakkah@localhost:5434/darmakkah"

# Clerk — from https://dashboard.clerk.com (API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OpenCode Go - server-only; omit the key to use the deterministic fake provider
OPENCODE_GO_API_KEY=""
OPENCODE_GO_MODEL="gpt-5.6-luna"
OPENCODE_GO_BASE_URL="https://opencode.ai/zen/go/v1/responses"
OPENCODE_GO_TIMEOUT_MS="30000"

# Per-Teacher AI generation guardrails (server-side)
AI_GENERATIONS_PER_HOUR="30"
AI_MAX_CONCURRENT_GENERATIONS="2"
AI_MAX_TOTAL_SOURCE_CHARS="120000"
